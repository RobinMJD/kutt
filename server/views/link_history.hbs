{{> header}}
<main class="link-archive">
  <div class="archive-heading"><h1>Link history</h1><a href="/">Links</a><a href="/settings/trash">Trash</a></div>
  <h2>{{link.link.link}}</h2><p>{{link.lifecycle_status}}</p>
  <ol class="archive-list">
    {{#each entries}}
      <li class="archive-item">
        <h2>{{action}}</h2><time datetime="{{created_at}}">{{created_at}}</time>
        <p>{{actor}} / {{source}}</p>
        {{#if changed}}<p>Changed: {{changed}}</p>{{/if}}
      </li>
    {{else}}<li>No recorded changes.</li>{{/each}}
  </ol>
  <nav class="archive-nav" aria-label="History pages">
    {{#if previous}}<a href="{{previous}}">Newer</a>{{/if}}
    {{#if next}}<a href="{{next}}">Older</a>{{/if}}
  </nav>
</main>
{{> footer}}
