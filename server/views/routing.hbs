{{> header}}
<main class="link-archive routing-page" data-link-id="{{id}}">
  <header class="archive-heading"><h1>Redirect rules</h1><a href="/settings/library">Library</a><a href="/">Links</a></header>
  <p class="routing-url">{{short_url}}</p>
  <div class="routing-fallback"><h2>Default destination</h2><p>{{target}}</p></div>
  <p id="routing-status" role="status" aria-live="polite">Loading...</p>
  <form id="routing-form">
    <ol id="routing-rules" aria-label="Ordered rules"></ol>
    <div class="routing-toolbar">
      <button type="button" id="routing-add" disabled>{{> icons/plus}} Add rule</button>
      <button type="submit" id="routing-save" class="primary" disabled>{{> icons/check}} Save rules</button>
      <button type="button" id="routing-reload" title="Reload saved rules" aria-label="Reload saved rules">{{> icons/reload}}</button>
    </div>
  </form>
  <section class="routing-preview"><h2>Test redirect</h2>
    <form id="routing-preview-form">
      <label>Device<select name="device" aria-label="Device"><option value="desktop">Desktop</option><option value="mobile">Mobile</option><option value="tablet">Tablet</option><option value="bot">Bot</option><option value="other">Other</option></select></label>
      <label>Preferred language<input name="language" placeholder="fr-FR" maxlength="35" /></label>
      <label>Country<input name="country" placeholder="FR" maxlength="2" /></label>
      <label>Query string<input name="query" placeholder="campaign=summer" maxlength="2048" /></label>
      <button type="submit" id="routing-test" disabled>Preview</button>
    </form>
    <output id="routing-result" aria-live="polite"></output>
  </section>
  <template id="routing-rule-template"><li class="routing-rule">
    <div class="routing-rule-heading"><h2></h2><div class="routing-rule-actions">
      <button type="button" data-action="up" title="Move rule up" aria-label="Move rule up"><span class="routing-up">{{> icons/chevron_left}}</span></button>
      <button type="button" data-action="down" title="Move rule down" aria-label="Move rule down"><span class="routing-down">{{> icons/chevron_right}}</span></button>
      <button type="button" data-action="remove" title="Remove rule" aria-label="Remove rule">{{> icons/trash}}</button>
    </div></div>
    <div class="routing-rule-fields"><label>Name<input data-field="name" required maxlength="80" /></label><label>Destination<input data-field="target" type="url" required maxlength="2040" /></label></div>
    <div class="routing-conditions"></div><button type="button" data-action="add-condition">{{> icons/plus}} Add condition</button>
  </li></template>
  <template id="routing-condition-template"><div class="routing-condition">
    <label>Condition<select data-field="kind" aria-label="Condition"><option value="devices">Device</option><option value="languages">Language</option><option value="countries">Country</option><option value="query">Query</option></select></label>
    <label data-part="device">Device<select data-field="device" aria-label="Device"><option value="desktop">Desktop</option><option value="mobile">Mobile</option><option value="tablet">Tablet</option><option value="bot">Bot</option><option value="other">Other</option></select></label>
    <label data-part="values" hidden>Values (comma-separated)<input data-field="values" maxlength="700" /></label>
    <label data-part="key" hidden>Query key<input data-field="key" maxlength="80" /></label>
    <label data-part="op" hidden>Match<select data-field="op" aria-label="Match"><option value="equals">Equals</option><option value="present">Present</option><option value="absent">Absent</option></select></label>
    <label data-part="value" hidden>Value<input data-field="value" maxlength="200" /></label>
    <button type="button" data-action="remove-condition" title="Remove condition" aria-label="Remove condition">{{> icons/x}}</button>
  </div></template>
</main>
<script src="/scripts/routing.js" defer></script>
{{> footer}}
