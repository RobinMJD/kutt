{{> header}}
<section id="verify-change-email" class="section-container verify-page">
  {{#if token_verified}}
    <h2>Email address is verified.</h2>
    <a href="/login">Continue to sign in</a>
  {{else}}
    <h2>
      {{> icons/x}}
      Couldn't verify the email address. Please try again.
    </h2>
    {{#if user}}
      <a href="/settings" title="Settings">Settings →</a>
    {{else}}
      {{#unless login_disabled}}<a href="/login" title="{{login_title}}">{{login_label}} →</a>{{/unless}}
    {{/if}}
  {{/if}}
</section>
{{> footer}}
