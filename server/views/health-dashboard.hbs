{{> header}}
<main class="link-archive health-page" data-health-dashboard="true">
  <header class="archive-heading"><h1>Destination monitoring</h1><a href="/settings/library">Library</a><a href="/">Links</a></header>
  <div class="health-toolbar"><button id="health-refresh" type="button" title="Refresh monitoring" aria-label="Refresh monitoring">{{> icons/reload}}</button></div>
  <p id="health-message" role="status" aria-live="polite">Loading...</p>
  <ul id="health-links"></ul>
  <button id="health-more" type="button" hidden>Load more</button>
</main>
<script src="/scripts/link-health.js" defer></script>
{{> footer}}
