{{> header}}
<section id="verify" class="section-container verify-page">
  {{#if token_verified}}
    <h2>Your account has been verified.</h2>
    <a href="/login">Continue to sign in</a>
  {{else}}
    <h2>
      {{> icons/x}}
      Invalid verification. Please try again.
    </h2>
    {{#unless login_disabled}}<a href="/login" title="{{login_title}}">{{login_label}} →</a>{{/unless}}
  {{/if}}
</section>
{{> footer}}
