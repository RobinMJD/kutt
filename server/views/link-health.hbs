{{> header}}
<main class="link-archive health-page" data-link-id="{{id}}">
  <header class="archive-heading"><h1>Destination health</h1><a href="/settings/health">Monitoring</a><a href="/settings/library">Library</a></header>
  <p>{{short_url}}</p>
  <p id="health-message" role="status" aria-live="polite">Loading...</p>
  <form id="health-form">
    <label class="health-toggle"><input type="checkbox" name="enabled" disabled />Monitor destinations</label>
    <label>Check interval (hours)<input name="interval_hours" type="number" min="1" max="168" value="24" required disabled /></label>
    <div class="health-toolbar">
      <button id="health-save" type="submit" disabled>{{> icons/check}} Save monitoring</button>
      <button id="health-check" type="button" disabled>{{> icons/heart}} Check now</button>
      <button id="health-reload" type="button" title="Reload saved monitoring" aria-label="Reload saved monitoring">{{> icons/reload}}</button>
    </div>
  </form>
  <section><h2 id="health-state">Not checked</h2><p id="health-times"></p><ul id="health-results"></ul></section>
</main>
<script src="/scripts/link-health.js" defer></script>
{{> footer}}
