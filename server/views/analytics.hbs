{{> header}}
<main class="link-archive analytics-page">
  <header class="archive-heading"><h1>Analytics</h1><a href="/settings/library">Library</a><a href="/">Links</a></header>
  <form id="analytics-filters" aria-label="Analytics filters">
    <input type="hidden" name="link" value="{{filters.link}}" />
    <label>From (UTC)<input type="date" name="start" value="{{filters.start}}" required /></label>
    <label>Through (UTC)<input type="date" name="end" value="{{filters.end}}" required /></label>
    <label>Search links<input type="search" name="q" value="{{filters.q}}" maxlength="200" /></label>
    <label>Domain<select name="domain" aria-label="Domain"><option value="{{filters.domain}}">{{#if filters.domain}}Selected domain{{else}}All domains{{/if}}</option></select></label>
    <label>Tag<select name="tag" aria-label="Tag"><option value="{{filters.tag}}">{{#if filters.tag}}Selected tag{{else}}All tags{{/if}}</option></select></label>
    <button type="submit" class="primary">Apply</button><a href="/settings/analytics">Clear</a>
  </form>
  <p id="analytics-status" role="status" aria-live="polite">Loading...</p>
  <div id="analytics-report" hidden>
    <div class="analytics-summary"><div><span>Tracked visits</span><strong id="analytics-total"></strong></div><div><span>Links with visits</span><strong id="analytics-links"></strong></div>
      <div class="analytics-exports"><a id="analytics-csv" download="kutt-analytics.csv" title="Download CSV"><span class="analytics-download">{{> icons/arrow_left}}</span> CSV</a><a id="analytics-json" download="kutt-analytics.json" title="Download JSON"><span class="analytics-download">{{> icons/arrow_left}}</span> JSON</a></div>
    </div>
    <section class="analytics-chart"><h2>Daily visits</h2><div class="analytics-canvas"><canvas id="analytics-chart" role="img" aria-label="Daily tracked visits. Values are also in the daily totals table."></canvas></div></section>
    <div class="analytics-tables">
      <section><h2>Tags</h2><p class="analytics-meta">Current assignments; overlapping totals</p><div data-table="tags"></div></section>
      <section><h2>Daily totals (UTC)</h2><div data-table="days"></div></section>
      <section><h2>Browsers</h2><div data-table="browser"></div></section>
      <section><h2>Operating systems</h2><div data-table="os"></div></section>
      <section><h2>Countries</h2><div data-table="country"></div></section>
      <section><h2>Referrers</h2><div data-table="referrer"></div></section>
    </div>
    <p class="analytics-meta" id="analytics-updated"></p>
    <p class="analytics-meta">Known bots excluded at ingestion. Historical aggregates cannot be reclassified.</p>
  </div>
</main>
<script src="/libs/chart.min.js" defer></script>
<script src="/scripts/analytics.js" defer></script>
{{> footer}}
