{{> header}}
<main class="link-archive library">
  <header class="archive-heading"><h1 data-page-focus tabindex="-1">Library</h1><a href="/">Links</a><a href="/settings/analytics">Analytics</a><a href="/settings/transfer">Import and export</a><a href="/settings/trash">Trash</a></header>
  {{#if error}}<p class="library-error" role="alert">{{error}}</p>{{/if}}
  <form class="library-filters" action="/settings/library" method="get" aria-label="Filter links">
    <label>Search<input type="search" name="q" value="{{filters.q}}" maxlength="200" /></label>
    <label>Tag<select name="tag" aria-label="Tag"><option value="">All tags</option>{{#each tags}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
    <label>Collection<select name="collection" aria-label="Collection"><option value="">All collections</option>{{#each collections}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
    <label>State<select name="state" aria-label="State">{{#each states}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>
    <button class="primary" type="submit">Filter</button><a href="/settings/library">Clear</a>
  </form>
  <nav class="library-saved" aria-label="Saved filters">
    {{#each saved_filters}}<a href="{{url}}">{{name}}</a>{{/each}}
  </nav>
  <details class="library-manage"><summary>Tags, collections and saved filters</summary>
    <div class="library-manage-grid">
      <section><h2>Tags and collections</h2>
        <form method="post" action="/settings/library" class="library-inline" aria-label="Create label">
          <input type="hidden" name="operation" value="save_label" /><input type="hidden" name="return_to" value="{{view_url}}" />
          <label>Kind<select name="kind" aria-label="Kind"><option value="tag">Tag</option><option value="collection">Collection</option></select></label>
          <label>Name<input name="name" required maxlength="80" /></label><button type="submit">Create</button>
        </form>
        {{#each labels}}
          <form method="post" action="/settings/library" class="library-inline library-label-edit" aria-label="Edit {{kind}} {{name}}">
            <input type="hidden" name="id" value="{{id}}" /><input type="hidden" name="kind" value="{{kind}}" /><input type="hidden" name="return_to" value="{{@root.view_url}}" />
            <label>{{kind}}<input name="name" value="{{name}}" required maxlength="80" /></label>
            <button class="library-icon" name="operation" value="save_label" title="Save name" aria-label="Save name">{{> icons/check}}</button>
            <button class="library-icon" name="operation" value="remove_label" title="Remove label" aria-label="Remove label" data-confirm="Remove this label from your links? The links themselves will remain.">{{> icons/trash}}</button>
          </form>
        {{/each}}
      </section>
      <section><h2>Saved filters</h2>
        <form method="post" action="/settings/library" class="library-inline" aria-label="Save current filter">
          <input type="hidden" name="operation" value="save_filter" /><input type="hidden" name="return_to" value="{{view_url}}" />
          {{> library/filter_fields filters}}
          <label>Filter name<input name="name" required maxlength="80" /></label><button type="submit">Save filter</button>
        </form>
        {{#each saved_filters}}
          <details class="library-filter-edit"><summary>{{name}}</summary>
            <form method="post" action="/settings/library" class="library-inline" aria-label="Edit filter {{name}}">
              <input type="hidden" name="id" value="{{id}}" /><input type="hidden" name="return_to" value="{{@root.view_url}}" />
              {{> library/filter_fields filters}}
              <label>Name<input name="name" value="{{name}}" required maxlength="80" /></label>
              <button class="library-icon" name="operation" value="save_filter" title="Save name" aria-label="Save name">{{> icons/check}}</button>
              <button class="library-icon" name="operation" value="remove_filter" title="Remove saved filter" aria-label="Remove saved filter" data-confirm="Remove this saved filter?">{{> icons/trash}}</button>
            </form>
            <form method="post" action="/settings/library">
              <input type="hidden" name="operation" value="save_filter" /><input type="hidden" name="id" value="{{id}}" /><input type="hidden" name="name" value="{{name}}" />
              <input type="hidden" name="return_to" value="{{@root.view_url}}" />{{> library/filter_fields @root.filters}}
              <button type="submit">Replace with current filters</button>
            </form>
          </details>
        {{/each}}
      </section>
    </div>
  </details>
  <form method="post" action="/settings/library" id="library-bulk">
    <input type="hidden" name="operation" value="bulk" /><input type="hidden" name="return_to" value="{{view_url}}" />
    <div class="library-toolbar">
      <label class="library-checkbox"><input type="checkbox" id="library-select-all" />Select page</label>
      <output id="library-selection" aria-live="polite">0 selected</output>
      <label>Action<select name="action" id="library-action" aria-label="Action"><option value="add_label">Add label</option><option value="remove_label">Remove label</option><option value="pause">Pause</option><option value="resume">Resume</option><option value="trash">Move to trash</option></select></label>
      <label id="library-label-field">Label<select name="label_id" aria-label="Label"><option value="">Select a label</option>{{#each labels}}<option value="{{id}}">{{kind}}: {{name}}</option>{{/each}}</select></label>
      <button type="submit" id="library-apply" disabled>Apply</button>
    </div>
    <p class="library-count">{{total}} links</p>
    <ul class="library-links">
      {{#each data}}
        <li>
          <label class="library-row-select"><input type="checkbox" name="ids" value="{{id}}" aria-label="Select {{address}}" {{#unless selectable}}disabled{{/unless}} /></label>
          <div class="library-link-main">
            <a href="{{link}}" target="_blank" rel="noopener noreferrer">{{link}}</a>
            <p class="library-target">{{target}}</p>
            {{#if description}}<p>{{description}}</p>{{/if}}
            <ul class="library-labels">{{#each labels}}<li class="library-label-{{kind}}">{{name}}</li>{{/each}}</ul>
          </div>
          <div class="library-link-meta"><span>{{lifecycle_status}}</span><a href="/link/history/{{id}}">History</a>{{#if selectable}}<a href="/link/routing/{{id}}" title="Redirect rules" aria-label="Redirect rules">{{> icons/shuffle}}</a><a href="/link/forwarding/{{id}}" title="Path and query forwarding" aria-label="Path and query forwarding">{{> icons/chevron_right}}</a><a href="/link/health/{{id}}" title="Destination health" aria-label="Destination health">{{> icons/heart}}</a><a href="/link/qr/{{id}}" title="QR code" aria-label="QR code">{{> icons/qrcode}}</a>{{/if}}</div>
        </li>
      {{else}}<li class="library-empty">No matching links.</li>{{/each}}
    </ul>
  </form>
  <nav class="archive-nav" aria-label="Library pages">{{#if previous}}<a href="{{previous}}">Previous</a>{{/if}}<span>Page {{page}}</span>{{#if next}}<a href="{{next}}">Next</a>{{/if}}</nav>
</main>
<script src="/scripts/library.js" defer></script>
{{> footer}}
