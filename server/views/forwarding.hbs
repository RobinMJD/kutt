{{> header}}
<main class="link-archive forwarding-page" data-link-id="{{id}}">
  <header class="archive-heading"><h1>Path and query forwarding</h1><a href="/settings/library">Library</a><a href="/">Links</a></header>
  <p>{{short_url}}</p><h2>Default destination</h2><p>{{target}}</p>
  <p id="forwarding-status" role="status" aria-live="polite">Loading...</p>
  <form id="forwarding-form">
    <div class="forwarding-lists">
      <label>Allowed query keys<textarea name="query_keys" rows="5" maxlength="1619" placeholder="utm_source&#10;campaign" disabled></textarea></label>
      <label>Allowed path prefixes<textarea name="path_prefixes" rows="5" maxlength="5139" placeholder="docs&#10;products/manuals" disabled></textarea></label>
    </div>
    <div class="forwarding-toolbar">
      <button type="submit" id="forwarding-save" disabled>{{> icons/check}} Save allowlists</button>
      <button type="button" id="forwarding-clear" disabled>{{> icons/x}} Clear allowlists</button>
      <button type="button" id="forwarding-reload" title="Reload saved allowlists" aria-label="Reload saved allowlists">{{> icons/reload}}</button>
    </div>
  </form>
  <section><h2>Test redirect</h2>
    <form id="forwarding-preview">
      <label>Path suffix<input name="path" maxlength="256" placeholder="docs/start" /></label>
      <label>Query string<input name="query" maxlength="2048" placeholder="utm_source=newsletter" /></label>
      <label>Device<select name="device"><option value="desktop">Desktop</option><option value="mobile">Mobile</option><option value="tablet">Tablet</option><option value="bot">Bot</option><option value="other">Other</option></select></label>
      <label>Preferred language<input name="language" maxlength="35" placeholder="fr-FR" /></label>
      <label>Country<input name="country" maxlength="2" placeholder="FR" /></label>
      <button type="submit" id="forwarding-test" disabled>Preview</button>
    </form>
    <output id="forwarding-result" aria-live="polite"></output>
  </section>
</main>
<script src="/scripts/forwarding.js" defer></script>
{{> footer}}
