<h2>
  Custom domain
</h2>
<p>
  You can set a custom domain for your short URLs, so instead of
  <b>{{default_domain}}/shorturl</b> you can have
  <b>yoursite.com/shorturl.</b>
</p>

{{#if server_cname_address}}
  <p>
    Point your domain's A record to 
    {{#if server_ip_address}}
      <b>{{server_ip_address}}</b>
    {{else}}
      our <b>IP address</b>
    {{/if}} or your subdomain's CNAME record to
    <b>{{server_cname_address}}</b>. HTTPS and proxy routing must be configured
    by the service administrator.
  </p>
  <p>Then add the domain and verify its DNS ownership:</p>
{{else}}
  <p>
    Point your domain's A record to 
    {{#if server_ip_address}}
      <b>{{server_ip_address}}</b>
    {{else}}
      our <b>IP address</b>
    {{/if}} 
    then add the domain and verify its DNS ownership:
  </p>
{{/if}}

{{> settings/domain/table}}
<div class="add-domain-wrapper">
  <button
    type="button"
    class="secondary show-domain-form"
    hx-indicator=".add-domain-wrapper"
    hx-get="/add-domain-form"
    hx-target="#domain-form-wrapper"
    hx-swap="innerHTML"
    hx-on::after-request="
      const loaded = event.detail.successful &amp;&amp; document.querySelector('#add-domain');
      document.getElementById('domain-load-error').hidden = !!loaded;
      if (loaded) this.classList.add('hidden');
    "
  >
    <span>{{> icons/plus}}</span>
    Add domain
  </button>
  {{> icons/spinner}}
  <p id="domain-load-error" class="error" role="alert" hidden>Could not load the domain form. Try again.</p>
  <div id="domain-form-wrapper">
  </div>
</div>
{{> settings/domain/dialog}}
