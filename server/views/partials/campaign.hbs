<details class="campaign" data-campaign>
  <summary>Campaign parameters</summary>
  <fieldset class="campaign-fields">
    <label>Source<input type="text" data-campaign-field="utm_source" maxlength="255" autocomplete="off" /></label>
    <label>Medium<input type="text" data-campaign-field="utm_medium" maxlength="255" autocomplete="off" /></label>
    <label>Campaign<input type="text" data-campaign-field="utm_campaign" maxlength="255" autocomplete="off" /></label>
    <label>Term<input type="text" data-campaign-field="utm_term" maxlength="255" autocomplete="off" /></label>
    <label>Content<input type="text" data-campaign-field="utm_content" maxlength="255" autocomplete="off" /></label>
  </fieldset>
  <section class="campaign-actions">
    <button type="button" data-campaign-apply>Apply parameters</button>
    <button type="button" data-campaign-clear>Clear parameters</button>
  </section>
  <output class="campaign-status" role="status" aria-live="polite"></output>
</details>
