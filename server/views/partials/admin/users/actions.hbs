<td class="actions users-actions">
  {{#if banned}}
    <button class="action banned" disabled="true" aria-label="{{t 'ui.banned'}}" data-tooltip="{{t 'ui.banned'}}">
      {{> icons/stop}}
    </button>
  {{/if}}
  {{#unless banned}}
    <button 
      class="action ban"
      type="button"
      aria-label="{{t 'ui.ban_user_value' value1=email}}"
      title="{{t 'ui.ban_user_2'}}"
      hx-on::before-request='openDialog("admin-table-dialog", null, this)'
      hx-get="/confirm-user-ban" 
      hx-target="#admin-table-dialog .content-wrapper" 
      hx-indicator="#admin-table-dialog" 
      hx-vals='{"id":"{{id}}"}'
    >
      {{> icons/stop}}
    </button>
  {{/unless}}
  <button 
    class="action delete"
    type="button"
    aria-label="{{t 'ui.delete_user_value' value1=email}}"
    title="{{t 'ui.delete_user_2'}}"
    hx-on::before-request='openDialog("admin-table-dialog", null, this)'
    hx-get="/confirm-user-delete" 
    hx-target="#admin-table-dialog .content-wrapper" 
    hx-indicator="#admin-table-dialog" 
    hx-vals='{"id":"{{id}}"}'
  >
    {{> icons/trash}}
  </button>
</td>
