<td class="actions users-actions">
  {{#if banned}}
    <button class="action banned" disabled="true" aria-label="Banned" data-tooltip="Banned">
      {{> icons/stop}}
    </button>
  {{/if}}
  {{#unless banned}}
    <button 
      class="action ban"
      type="button"
      aria-label="Ban user {{email}}"
      title="Ban user"
      hx-on:click='openDialog("admin-table-dialog")' 
      hx-get="/confirm-user-ban" 
      hx-target="#admin-table-dialog .content-wrapper" 
      hx-indicator="#admin-table-dialog" 
      hx-vals='{"id":"{{id}}"}'
    >
      {{> icons/stop}}
    </button>
  {{/unless}}
  <button 
    class="action delete"
    type="button"
    aria-label="Delete user {{email}}"
    title="Delete user"
    hx-on:click='openDialog("admin-table-dialog")' 
    hx-get="/confirm-user-delete" 
    hx-target="#admin-table-dialog .content-wrapper" 
    hx-indicator="#admin-table-dialog" 
    hx-vals='{"id":"{{id}}"}'
  >
    {{> icons/trash}}
  </button>
</td>
