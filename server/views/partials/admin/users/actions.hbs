<td class="actions users-actions">
  {{#if banned}}
    <a class="button action banned" href="/admin/moderation/user/{{id}}" aria-label="Remove ban for {{email}}" title="Remove ban">
      {{> icons/stop}}
    </a>
  {{/if}}
  {{#unless banned}}
    <button 
      class="action ban"
      type="button"
      aria-label="Ban user {{email}}"
      title="Ban user"
      hx-on::before-request='openDialog("admin-table-dialog", null, this)'
      hx-get="/confirm-user-ban" 
      hx-target="#admin-table-dialog .content-wrapper" 
      hx-indicator="#admin-table-dialog" 
      hx-vals='{"id":"{{id}}"}'
    >
      {{> icons/stop}}
    </button>
  {{/unless}}
  <button 
    class="action delete"
    type="button"
    aria-label="Delete user {{email}}"
    title="Delete user"
    hx-on::before-request='openDialog("admin-table-dialog", null, this)'
    hx-get="/confirm-user-delete" 
    hx-target="#admin-table-dialog .content-wrapper" 
    hx-indicator="#admin-table-dialog" 
    hx-vals='{"id":"{{id}}"}'
  >
    {{> icons/trash}}
  </button>
</td>
