<tr id="tr-{{id}}" {{#if swap_oob}}hx-swap-oob="true"{{/if}}>
  <td class="users-id">
    <span class="table-field-label" aria-hidden="true">ID</span>
    {{id}}
  </td>
  <td class="users-email">
    <span class="table-field-label" aria-hidden="true">Email / domains</span>
    {{email}}
    <p class="description">
      {{#if domains}}
        <button type="button" class="link-button" data-focus-after="#tab-domains" aria-label="View domains"
          data-tooltip="View domains" 
          hx-get="/api/domains/admin"
          hx-target="closest table"
          hx-swap="outerHTML settle:0ms"
          hx-sync="this:replace"
          hx-indicator="closest table"
          hx-vals='{"user":"{{email}}"}'
        >
          {{domains}}
        </button>
      {{else}}
        <span>No domains</span>
      {{/if}}
    </p>
  </td>
  <td class="users-created-at">
    <span class="table-field-label" aria-hidden="true">Created at</span>
    {{relative_created_at}}
  </td>
  <td class="users-verified">
    <span class="table-field-label" aria-hidden="true">Verified</span>
    {{#if verified}}
      <span class="status green">VERIFIED</span>
    {{else}}
      <span class="status gray">NOT VERIFIED</span>
    {{/if}}
  </td>
  <td class="users-role">
    <span class="table-field-label" aria-hidden="true">Role</span>
    {{#ifEquals role "ADMIN"}}
    <span class="status red">ADMIN</span>
    {{else}}
    <span class="status gray">USER</span>
    {{/ifEquals}}
  </td>
  <td class="users-links-count">
    <span class="table-field-label" aria-hidden="true">Total links</span>
    {{#ifEquals links_count '0'}}
      {{links_count}}
    {{else}}
      <button type="button" class="link-button" data-focus-after="#tab-links" data-tooltip="View links"
        aria-label="View links"
        hx-get="/api/links/admin"
        hx-target="closest table"
        hx-swap="outerHTML settle:0ms"
        hx-sync="this:replace"
        hx-vals='{"user":"{{email}}"}'
        hx-indicator="closest table"
      >
        {{links_count}}
      </button>
    {{/ifEquals}}
  </td>
  {{> admin/users/actions}}
</tr>
<tr class="edit">
  <td class="loading">
    {{> icons/spinner}}
  </td>
</tr>
