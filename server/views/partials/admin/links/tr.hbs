<tr id="tr-{{id}}" {{#if swap_oob}}hx-swap-oob="true"{{/if}}>
  <td class="original-url right-fade">
    <span class="table-field-label" aria-hidden="true">Original URL / owner</span>
    <a href="{{target}}" title="{{target}}" target="_blank" rel="noopener noreferrer">
      {{target}}
    </a>
    <p class="description">
      by&nbsp;
      {{~#if user_id~}}
        <button type="button" class="link-button" data-focus-after="#tab-users" aria-label="View user"
          data-tooltip="View user" 
          hx-get="/api/users/admin"
          hx-target="closest table"
          hx-swap="outerHTML settle:0ms"
          hx-sync="this:replace"
          hx-indicator="closest table"
          hx-vals='{"search":"{{email}}"}'
        >
          {{email}}
        </button>
        {{#ifEquals @root.query.user email}}
        {{else}}
          &nbsp;(
          <button type="button" class="link-button" data-focus-after="#tab-links" aria-label="View links by this user"
            data-tooltip="View links by this user" 
            hx-get="/api/links/admin"
            hx-target="closest table"
            hx-swap="outerHTML settle:0ms"
            hx-sync="this:replace"
            hx-indicator="closest table"
            hx-vals='{"user":"{{email}}"}'
          >
            view links
          </button>)
        {{/ifEquals}}
      {{~else~}}
        <button type="button" class="link-button" data-focus-after="#tab-links" aria-label="View anonymous links"
          data-tooltip="View anonymous links" 
          hx-get="/api/links/admin"
          hx-target="closest table"
          hx-swap="outerHTML settle:0ms"
          hx-sync="this:replace"
          hx-indicator="closest table"
          hx-vals='{"anonymous":"true"}'
        >
          Anonymous
        </button>
      {{~/if~}}
      &nbsp;{{~#if description~}}· {{description}}{{~/if}}
    </p>
  </td>
  <td class="created-at">
    <span class="table-field-label" aria-hidden="true">Created at</span>
    {{relative_created_at}}
    {{#if relative_expire_in}}
      <p class="description">
        Expires in {{relative_expire_in}}
      </p>
    {{/if}}
  </td>
  <td class="short-link right-fade">
    <span class="table-field-label" aria-hidden="true">Short link / domain</span>
    <div class="short-link-wrapper">
      <div class="clipboard small">
        <button 
          aria-label="Copy" 
          hx-on:click="handleShortURLCopyLink(this);"
          data-url="{{link.url}}"
        >
          {{> icons/copy}}
        </button>
        {{> icons/check}}
      </div>
      <a href="{{link.url}}">/{{link.address}}</a>
    </div>
    <p class="description">
      <button type="button" class="link-button" data-focus-after="#tab-links" aria-label="View links by this domain"
        data-tooltip="View links by this domain" 
        hx-get="/api/links/admin"
        hx-target="closest table"
        hx-swap="outerHTML settle:0ms"
        hx-sync="this:replace"
        hx-vals='{"domain":"{{domain}}"}'
        hx-indicator="closest table"
      >{{domain}}</button>
    </p>
  </td>
  <td class="views">
    <span class="table-field-label" aria-hidden="true">Views</span>
    {{visit_count}}
  </td>
    {{> admin/links/actions}}
</tr>
<tr class="edit">
  <td class="loading">
    {{> icons/spinner}}
  </td>
</tr>
