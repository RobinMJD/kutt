<td class="actions">
  {{#if password}}
    <button class="action password" disabled="true" aria-label="Password protected" data-tooltip="Password protected">
      {{> icons/key}}
    </button>
  {{/if}}
  {{#if banned}}
    <a class="button action banned" href="/admin/moderation/link/{{id}}" aria-label="Remove ban for {{link.address}}" title="Remove ban">
      {{> icons/stop}}
    </a>
  {{/if}}
  <a
    class="button action stats"
    href="/stats?id={{id}}"
    title="Statistics"
    aria-label="Statistics for {{link.address}}"
  >
    {{> icons/chart}}
  </a>
  <button
    class="action qrcode"
    type="button"
    aria-label="QR code for {{link.address}}"
    title="QR code"
    hx-on:click="handleQRCode(this, 'admin-table-dialog')"
    data-url="{{link.url}}"
  >
    {{> icons/qrcode}}
  </button>
  <button 
    class="action edit"
    id="edit-opener-{{id}}"
    type="button"
    aria-label="Edit {{link.address}}"
    title="Edit link"
    hx-trigger="click queue:none"
    hx-ext="path-params"
    hx-get="/admin/link/edit/{id}" 
    hx-vals='{"id":"{{id}}"}'
    hx-swap="beforeend settle:0ms"
    hx-target="next tr.edit"
    hx-indicator="next tr.edit"
    hx-sync="this:drop"
    hx-on::before-request="
      const tr = event.detail.target;
      tr.classList.add('show');
      if (tr.querySelector('.content')) {
        event.preventDefault();
        tr.classList.remove('show');
        tr.removeChild(tr.querySelector('.content'));
      }
    "
  >
    {{> icons/pencil}}
  </button>
  {{#unless banned}}
    <button 
      class="action ban"
      type="button"
      aria-label="Ban {{link.address}}"
      title="Ban link"
      hx-on::before-request='openDialog("admin-table-dialog", null, this)'
      hx-get="/confirm-link-ban" 
      hx-target="#admin-table-dialog .content-wrapper" 
      hx-indicator="#admin-table-dialog" 
      hx-vals='{"id":"{{id}}"}'
    >
      {{> icons/stop}}
    </button>
  {{/unless}}
  <button 
    class="action delete"
    type="button"
    aria-label="Move {{link.address}} to trash"
    title="Move to trash"
    hx-on::before-request='openDialog("admin-table-dialog", null, this)'
    hx-get="/confirm-link-delete" 
    hx-target="#admin-table-dialog .content-wrapper" 
    hx-indicator="#admin-table-dialog" 
    hx-vals='{"id":"{{id}}"}'
  >
    {{> icons/trash}}
  </button>
</td>
