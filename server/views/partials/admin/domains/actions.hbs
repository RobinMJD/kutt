<td class="actions domains-actions">
  {{#if banned}}
    <a class="button action banned" href="/admin/moderation/domain/{{id}}" aria-label="Remove ban for {{address}}" title="Remove ban">
      {{> icons/stop}}
    </a>
  {{/if}}
  {{#unless banned}}
    <button 
      class="action ban"
      type="button"
      aria-label="Ban domain {{address}}"
      title="Ban domain"
      hx-on::before-request='openDialog("admin-table-dialog", null, this)'
      hx-get="/confirm-domain-ban" 
      hx-target="#admin-table-dialog .content-wrapper" 
      hx-indicator="#admin-table-dialog" 
      hx-vals='{"id":"{{id}}"}'
    >
      {{> icons/stop}}
    </button>
  {{/unless}}
  <button 
    class="action delete"
    type="button"
    aria-label="Delete domain {{address}}"
    title="Delete domain"
    hx-on::before-request='openDialog("admin-table-dialog", null, this)'
    hx-get="/confirm-domain-delete-admin" 
    hx-target="#admin-table-dialog .content-wrapper" 
    hx-indicator="#admin-table-dialog" 
    hx-vals='{"id":"{{id}}"}'
  >
    {{> icons/trash}}
  </button>
</td>
