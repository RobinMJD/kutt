<tr id="tr-{{id}}" {{#if swap_oob}}hx-swap-oob="true"{{/if}}>
  <td class="domains-id">
    <span class="table-field-label" aria-hidden="true">ID</span>
    {{id}}
  </td>
  <td class="domains-address right-fade">
    <span class="table-field-label" aria-hidden="true">Address / owner</span>
    {{address}}
    <p class="description">
      by&nbsp;
      {{~#if user_id~}}
        <button type="button" class="link-button" data-focus-after="#tab-users" aria-label="View user"
          data-tooltip="View user" 
          hx-get="/api/users/admin"
          hx-target="closest table"
          hx-swap="outerHTML settle:0ms"
          hx-sync="this:replace"
          hx-indicator="closest table"
          hx-vals='{"search":"{{email}}"}'
        >
          {{email}}
        </button>
        {{#ifEquals @root.query.user email}}
        {{else}}
          &nbsp;(
          <button type="button" class="link-button" data-focus-after="#tab-domains" aria-label="View domains"
            data-tooltip="View domains" 
            hx-get="/api/domains/admin"
            hx-target="closest table"
            hx-swap="outerHTML settle:0ms"
            hx-sync="this:replace"
            hx-indicator="closest table"
            hx-vals='{"user":"{{email}}"}'
          >
            view domains
          </button>)
        {{/ifEquals}}
      {{~else~}}
        <button type="button" class="link-button" data-focus-after="#tab-domains" aria-label="View system domains"
          data-tooltip="View system domains" 
          hx-get="/api/domains/admin"
          hx-target="closest table"
          hx-swap="outerHTML settle:0ms"
          hx-sync="this:replace"
          hx-indicator="closest table"
          hx-vals='{"owner":"false"}'
        >
          System
        </button>
      {{~/if~}}
      &nbsp;{{~#if description~}}· {{description}}{{~/if}}
    </p>
  </td>
  <td class="domains-homepage right-fade">
    <span class="table-field-label" aria-hidden="true">Homepage</span>
    {{#if homepage}}
      <a href="{{homepage}}" title="{{homepage}}" target="_blank" rel="noopener noreferrer">
        {{homepage}}
      </a>
    {{else}}
      No homepage
    {{/if}}
  </td>
  <td class="domains-created-at">
    <span class="table-field-label" aria-hidden="true">Created at</span>
    {{relative_created_at}}
  </td>
  <td class="domains-links-count">
    <span class="table-field-label" aria-hidden="true">Total links</span>
    {{#ifEquals links_count '0'}}
      {{links_count}}
    {{else}}
      <button type="button" class="link-button" data-focus-after="#tab-links" data-tooltip="View links"
        aria-label="View links"
        hx-get="/api/links/admin"
        hx-target="closest table"
        hx-swap="outerHTML settle:0ms"
        hx-sync="this:replace"
        hx-vals='{"domain":"{{address}}"}'
        hx-indicator="closest table"
      >
        {{links_count}}
      </button>
    {{/ifEquals}}
  </td>
  {{> admin/domains/actions}}
</tr>
<tr class="edit">
  <td class="loading">
    {{> icons/spinner}}
  </td>
</tr>
