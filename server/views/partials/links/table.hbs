<section id="main-table-wrapper">
  <h2>Recent shortened links.</h2>
  <nav class="archive-nav"><a href="/settings/library">Library</a><a href="/settings/analytics">Analytics</a><a href="/settings/workspaces">Workspaces</a><a href="/settings/trash">Trash</a></nav>
  <table 
    hx-get="/api/links"
    hx-target="tbody"
    hx-swap="outerHTML settle:0ms"
    hx-select="tbody"
    hx-disinherit="*"
    hx-include=".links-controls"
    hx-params="not total"
    hx-sync="this:replace"
    hx-select-oob="#total" 
    hx-trigger="load once, reloadMainTable from:body, click delay:100ms from:button.nav, input changed delay:500ms from:#search"
    hx-on:htmx:after-on-load="updateLinksNav()"
  >
    {{> links/thead}}
    {{> links/tbody}}
    {{> links/tfoot}}
  </table>
  {{> links/dialog/frame}}
</section>
