<form id="lifecycle-{{id}}" class="link-lifecycle" method="post" action="/api/links/{{#if admin_lifecycle}}admin/{{/if}}{{id}}/lifecycle"
  hx-patch="/api/links/{{#if admin_lifecycle}}admin/{{/if}}{{id}}/lifecycle" hx-select="#lifecycle-{{id}}" hx-swap="outerHTML settle:0ms">
  <fieldset>
    <legend>{{t "ui.availability"}}</legend>
    <label class="lifecycle-checkbox"><input type="checkbox" name="paused" {{#if paused}}checked{{/if}} /> <span>{{t "ui.paused"}}</span></label>
    {{> date_time_field name="starts_at" key=id local=true value=starts_at_local_input label=(t "schedule.start_local") choose=(t "schedule.choose_start") empty=(t "schedule.immediately") conflict=schedule_conflict current=current_start}}
    {{> date_time_field name="ends_at" key=id local=true value=ends_at_local_input label=(t "schedule.end_local") choose=(t "schedule.choose_end") empty=(t "schedule.no_end") conflict=schedule_conflict current=current_end}}
    <label>{{t "ui.maximum_redirects"}}<input type="number" name="max_visits" min="1" max="2147483647" step="1" value="{{max_visits}}" /></label>
    <input type="hidden" name="schedule_mode" value="absolute" />
    <input type="hidden" name="availability_snapshot" value="{{availability_snapshot}}" />
    <input type="hidden" name="expiry_snapshot" value="{{expiry_snapshot}}" />
    {{#if schedule_conflict}}<small class="lifecycle-current">{{t "schedule.current_policy"}} {{current_label}} &middot; {{t "ui.maximum_redirects"}}: {{#if current_limit}}{{current_limit}}{{else}}{{t "ui.none"}}{{/if}}</small>{{/if}}
    <p>{{lifecycle_label}} &middot; {{t "lifecycle.redirects" count=redirect_count formatted=(number redirect_count)}}</p>
    <button type="submit" class="primary" id="availability-submit-{{id}}">{{t "ui.save_availability"}}</button>
  </fieldset>
  <div class="response" role="status">
    {{#if error}}<p class="error">{{error}}</p>{{else if success}}<p class="success">{{success}}</p>{{/if}}
  </div>
  {{#if success}}
    <template><p id="lifecycle-status-{{id}}" class="description" hx-swap-oob="true">{{lifecycle_label}}</p></template>
  {{/if}}
</form>
