{{> header}}
<main class="link-archive shortcut-page">
  <header class="archive-heading"><h1>iOS Shortcut</h1><a href="/settings">Settings</a><a href="/settings/library">Library</a></header>
  <div class="shortcut-template"><a href="/api/v2/shortcuts/template" download>Download Shortcut</a><a href="/api/v2/shortcuts/guide" target="_blank" rel="noopener">Setup and recovery guide</a></div>
  <label for="shortcut-endpoint">API endpoint</label>
  <div class="shortcut-value"><input id="shortcut-endpoint" value="{{endpoint}}" readonly /><button id="shortcut-copy-endpoint" type="button" title="Copy API endpoint" aria-label="Copy API endpoint" disabled>{{> icons/copy}}</button></div>
  <form id="shortcut-form">
    <label for="shortcut-name">Shortcut name</label><input id="shortcut-name" name="name" maxlength="80" required value="iPhone Shortcut" autocomplete="off" />
    <dl class="shortcut-policy"><dt>Permission</dt><dd>Create links only</dd><dt>Domain</dt><dd>{{default_domain}}</dd><dt>Expiry</dt><dd>30 days</dd></dl>
    <button id="shortcut-create" type="submit" disabled>{{> icons/plus}} Create Shortcut token</button>
  </form>
  <p id="shortcut-message" role="status" aria-live="polite"></p>
  <section id="shortcut-secret" hidden>
    <h2>New credential</h2><p>Shown once. Do not share or publish a configured Shortcut.</p>
    <label for="shortcut-token">API token</label>
    <div class="shortcut-value"><input id="shortcut-token" type="password" readonly autocomplete="off" /><button id="shortcut-reveal" type="button" title="Show API token" aria-label="Show API token" aria-pressed="false">{{> icons/eye}}</button><button id="shortcut-copy-token" type="button" title="Copy API token" aria-label="Copy API token">{{> icons/copy}}</button></div>
    <p id="shortcut-expiry"></p>
    <button id="shortcut-hide" type="button">Hide credential</button>
    <button id="shortcut-revoke" type="button">{{> icons/trash}} Revoke this token</button>
  </section>
</main>
<script src="/scripts/shortcuts.js" defer></script>
{{> footer}}
