{{> header}}
<main id="moderation" class="moderation-page">
  <h1>Moderation</h1>
  <nav><a href="/admin">Administration</a></nav>
  <form method="get" action="/admin/moderation">
    <label for="moderation-entity">Banned entries</label>
    <select id="moderation-entity" name="entity">
      <option value="user" {{#ifEquals entity 'user'}}selected{{/ifEquals}}>Users</option>
      <option value="link" {{#ifEquals entity 'link'}}selected{{/ifEquals}}>Links</option>
      <option value="domain" {{#ifEquals entity 'domain'}}selected{{/ifEquals}}>Domains</option>
      <option value="host" {{#ifEquals entity 'host'}}selected{{/ifEquals}}>Destination IP addresses</option>
    </select>
    <button class="primary" type="submit">Filter</button>
  </form>
  <h2>Banned entries ({{total}})</h2>
  <ul class="moderation-list">
    {{#each bans}}
      <li><span>{{label}}</span><a href="/admin/moderation/{{entity}}/{{id}}">Remove ban</a></li>
    {{else}}<li>No banned entries.</li>{{/each}}
  </ul>
  <h2>Activity ({{event_total}})</h2>
  <ul class="moderation-list">
    {{#each events}}
      <li><time datetime="{{created_at}}">{{created_at}}</time><span>{{action}}: {{entity}} #{{entity_id}}</span><span>Administrator #{{#if actor_id}}{{actor_id}}{{else}}deleted{{/if}}</span></li>
    {{else}}<li>No recorded moderation actions.</li>{{/each}}
  </ul>
  <nav aria-label="Moderation pages">
    {{#if previous}}<a href="?entity={{entity}}&amp;page={{previous}}">Previous</a>{{/if}}
    <span>Page {{page}}</span>
    {{#if next}}<a href="?entity={{entity}}&amp;page={{next}}">Next</a>{{/if}}
  </nav>
</main>
{{> footer}}
